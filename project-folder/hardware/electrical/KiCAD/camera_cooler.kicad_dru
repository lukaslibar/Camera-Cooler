(version 1)
(rule "USB to zone clearance"
  (constraint clearance (min 0.30mm))
  (condition "(A.NetName == 'USB_DP' || A.NetName == 'USB_DN' || A.NetName == 'DP' || A.NetName == 'DN') && B.Type == 'Zone' || (B.NetName == 'USB_DP' || B.NetName == 'USB_DN' || B.NetName == 'DP' || B.NetName == 'DN') && A.Type == 'Zone'")
)
